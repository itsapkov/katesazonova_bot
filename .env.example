# --- Telegram ---------------------------------------------------------------
# Токен из @BotFather. ВАЖНО: старый токен был засвечен — сделайте Revoke
# и вставьте сюда новый.
BOT_TOKEN=

# Telegram ID Кати — сюда бот пришлёт уведомление о каждой оплате.
# Узнать: написать боту /id
ADMIN_CHAT_ID=

# Аккаунт для кнопки «Написать Кате»
CONTACT_URL=https://t.me/KateSazonova

# --- lava.top ---------------------------------------------------------------
# Личный кабинет lava.top -> Настройки -> API -> создать ключ
LAVA_API_KEY=

# offerId продукта. Получить: python tools/list_offers.py
LAVA_OFFER_ID=

# --- Доступ к материалам ----------------------------------------------------
# Ссылка, которая уходит покупателю после оплаты
# (инвайт в закрытый канал / Notion / Google Drive)
ACCESS_URL=

# --- Веб-сервер для вебхуков lava.top --------------------------------------
PORT=8080
# Путь вебхука. Добавьте в конец случайные символы, чтобы адрес было не угадать.
LAVA_WEBHOOK_PATH=/lava-webhook-3f9a2c
# Публичный адрес сервиса (выдаёт хостинг), например:
PUBLIC_URL=

# --- Цены (фолбэк, если API lava.top недоступен) ---------------------------
PRICE_RUB=4900
PRICE_EUR=55
PRICE_USD=59
